}
Choice.changeopenexe{
	"\0\b[2]请选择想要放在菜单上的功能：\_q\n/
	\![*]\q[OneNote,Onchangeouma,OneNote,openonenote]\n/
	\![*]\q[outlook,Onchangeouma,outlook,openoutlook]\n/
