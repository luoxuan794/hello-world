	\![*]%(ofenusename[0])\_l[150,-]\![*]%(ofenusename[1])\n/
	\![*]%(ofenusename[2])\_l[150,-]\![*]%(ofenusename[3])\n/
	\![*]%(ofenusename[4])\_l[150,-]\![*]%(ofenusename[5])\n/
	\n\![*]\q[恢复为默认,resetallname]\e"
}

//恢复默认排布
Choice.resetallname{
	ofenusename=("OneNote","Outlook","WindowsMediaPlayer","崩坏三扫码器","清空回收站","重载ghost")
	ofenuseexena=("openonenote","openoutlook","wmplayer","scaner","erbin","reloadtoupgrade")
	"\0默认排布恢复成功。\e"
}

//更改排布
Onchangeouma{
	"\b[2]请选择想要替换掉的功能：\_q\n/
	\![*]\q[%(ofenusename[0]),Onchangeoumb,0,%(reference0),%(reference1)]\_l[150,-]\![*]\q[%(ofenusename[1]),Onchangeoumb,1,%(reference0),%(reference1)]\n/
	\![*]\q[%(ofenusename[2]),Onchangeoumb,2,%(reference0),%(reference1)]\_l[150,-]\![*]\q[%(ofenusename[3]),Onchangeoumb,3,%(reference0),%(reference1)]\n/
	\![*]\q[%(ofenusename[4]),Onchangeoumb,4,%(reference0),%(reference1)]\_l[150,-]\![*]\q[%(ofenusename[5]),Onchangeoumb,5,%(reference0),%(reference1)]\n/
	\![*]\q[返回,ReturnMenu]\_l[150,-]\![*]\q[取消,Cancel]\e"
}
//执行更换
Onchangeoumb{
	ofenusename[reference0]=reference1
	ofenuseexena[reference0]=reference2
	"\0\s[1]已将%(ofenusename[reference0])更换到菜单页面。\e"
}

//第一次打开exe
询问文件地址{
	"\0\s[4]helper还不清楚office文件夹的位置，可以告诉helper吗？helper会一直记得的！\n\![*]\q[输入文件位置,tellexefilename]\_l[150,-]\![*]\q[不告诉你,refusetellfilename]"
}
Choice.tellexefilename{
	"\0\s[1]好的，请说。\![open,inputbox,teachexefilename]"
}
Input.teachexefilename{
	
	if reference1==""{
		"\0\s[4]没有收到文件地址哦。\e"
	}
	else{
		if xex>0 && xex<6{
			officefile=reference1
		}
	}
	"\0\s[1]地址是%(officefile)，要现在就打开%(exename[xex])吗？\n\![*]\q[打开,open%(exename[xex])]"
}
Choice.refusetellfilename{
	"\0\s[3]对不起，helper是笨蛋。\e"
}



//打开onenote   C:\Program Files\Microsoft Office\root\Office16\ONENOTE.EXE
Choice.openonenote{
	xex=1
	if officefile==""{
		询问文件地址()
	}else{
		exefile[xex]=officefile+"\ONENOTE.EXE"
		"\0\s[1]\![open,file,%(exefile[xex])]好哦，要开始学习了吗~\e"
		xex=0
	}
	menuflag=0
}

//open outlook		C:\Program Files\Microsoft Office\root\Office16\OUTLOOK.EXE
Choice.openoutlook{
	xex=2
	//exefile[xex]="空"
	if officefile==""{
		询问文件地址()
	}else{
		exefile[xex]=officefile+"\OUTLOOK.EXE"
		"\0\s[1]\![open,file,%(exefile[xex])]为您打开outlook，要发邮件还是查看日程呢？\e"
		xex=0

	}
	menuflag=0
}
//open word
Choice.openword{
	xex=3
	if officefile==""{
		询问文件地址()
	}else{
		exefile[xex]=officefile+"\WINWORD.EXE"
		"\0\s[1]\![open,file,%(exefile[xex])]为您打开word，记得及时保存进度哦~\e"
	}
	menuflag=0
}
Choice.openPPT{
	xex=4
	if officefile==""{
		询问文件地址()
	}else{
		exefile[xex]=officefile+"\POWERPNT.EXE"
		"\0\s[1]\![open,file,%(exefile[xex])]打开PPT，制作ppt的话，还是先有模板再开工会更方便呢。\e"
	}
	menuflag=0
}
Choice.openexcel{
	xex=5
	if officefile==""{
		询问文件地址()
	}else{
		exefile[xex]=officefile+"\EXCEL.EXE"
		"\0\s[1]\![open,file,%(exefile[xex])]为您打开excel，是表格软件，也是绘图软件，功能强大，超出你的想象！\e"
	}
	menuflag=0
}

